// ============================================
// DURASI DEFAULT
// ============================================

const DEFAULT_DURATION = {
  Football: 120,
  Basketball: 150,
  Volleyball: 120,
  Badminton: 120,
  Tennis: 180,
  Boxing: 180,
  UFC: 180,
  "Formula 1": 150,
  MotoGP: 90,
  Golf: 300
};


// ============================================
// STATUS OTOMATIS WIB
// ============================================

function getEventStatus(event) {

  if (!event.date || !event.time) {
    return "UPCOMING";
  }

  const start = new Date(
    `${event.date}T${event.time}:00+07:00`
  );

  const duration =
    Number(event.duration) ||
    DEFAULT_DURATION[event.category] ||
    120;

  const end = new Date(
    start.getTime() +
    duration * 60 * 1000
  );

  const now = new Date();

  if (now < start) {
    return "UPCOMING";
  }

  if (now >= start && now < end) {
    return "LIVE";
  }

  return "FINISHED";
}


// ============================================
// UPDATE STATUS SEMUA EVENT
// ============================================

function updateStatuses(schedule) {

  schedule.events = schedule.events.map(event => {

    return {
      ...event,
      status: getEventStatus(event)
    };

  });

  return schedule;
}


// ============================================
// CLOUDFLARE WORKER
// ============================================

export default {

  async fetch(request, env, ctx) {

    const data = structuredClone(SCHEDULE);

    const result = updateStatuses(data);

    return new Response(
      JSON.stringify(result, null, 2),
      {
        status: 200,

        headers: {
          "Content-Type":
            "application/json; charset=UTF-8",

          "Cache-Control":
            "no-store, no-cache, must-revalidate, max-age=0",

          "Access-Control-Allow-Origin": "*"
        }
      }
    );
  }

};
